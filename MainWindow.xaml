<ui:FluentWindow
  x:Class="LingChat.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="LingChat"
  Width="1180"
  Height="760"
  MinWidth="920"
  MinHeight="620"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  mc:Ignorable="d"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
      Grid.Row="0"
      Title="LingChat"
      Icon="{ui:ImageIcon 'pack://application:,,,/Assets/wpfui-icon-256.png'}"
    >
            <ui:TitleBar.Header>
                <TextBlock
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          Opacity="0.78"
          Text="桌面客户端"
        />
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <TextBlock x:Name="ModeTextBlock"
          Margin="0,0,16,0"
          VerticalAlignment="Center"
          Opacity="0.68"
          Text="页面注册模式"
        />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView
        x:Name="RootNavigationView"
        Grid.Column="0"
        PaneDisplayMode="Left"
        OpenPaneLength="250"
        IsPaneToggleVisible="False"
        IsBackButtonVisible="Collapsed"
        PaneTitle="工作区"
      >
                <ui:NavigationView.PaneHeader>
                    <StackPanel>
                        <Image Height="127" HorizontalAlignment="Left" Source="/Logo.png" Width="247"/>
                        <TextBlock
              FontSize="24"
              FontWeight="SemiBold"
              Text="LingChat启动器" HorizontalAlignment="Center" VerticalAlignment="Center"
            />
                    </StackPanel>

                </ui:NavigationView.PaneHeader>
    </ui:NavigationView>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="PageHeaderSpacerRow" Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ContentControl x:Name="PageHeaderHost" Grid.Row="0" />
                <ContentControl x:Name="PageContentHost" Grid.Row="2" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
