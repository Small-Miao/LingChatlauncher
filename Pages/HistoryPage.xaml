<UserControl
  x:Class="LingChat.Pages.HistoryPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <ui:Card Padding="24">
    <StackPanel>
      <TextBlock
        FontSize="22"
        FontWeight="SemiBold"
        Text="历史记录"
      />
      <TextBlock
        Margin="0,10,0,0"
        Text="这里可以继续扩展为本地会话列表、任务日志或安装记录页。"
        TextWrapping="Wrap"
      />
      <Separator Margin="0,18,0,18" />
      <TextBlock
        FontWeight="SemiBold"
        Text="当前示例："
      />
      <TextBlock
        Margin="0,8,0,0"
        Text="1. 每个页面使用独立 XAML 文件。"
        TextWrapping="Wrap"
      />
      <TextBlock
        Margin="0,6,0,0"
        Text="2. 导航项通过注册表统一挂载到左侧菜单。"
        TextWrapping="Wrap"
      />
      <TextBlock
        Margin="0,6,0,0"
        Text="3. 主窗口只负责导航和页面承载。"
        TextWrapping="Wrap"
      />
    </StackPanel>
  </ui:Card>
</UserControl>
