<UserControl
  x:Class="LingChat.Pages.ChatPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  d:DesignHeight="600"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="*" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:Card Grid.Row="0" Padding="20">
      <StackPanel>
        <TextBlock
          FontSize="20"
          FontWeight="SemiBold"
          Text="会话状态"
        />
        <TextBlock
          x:Name="CounterTextBlock"
          Margin="0,10,0,0"
          Text="消息数：0"
        />
        <TextBlock
          x:Name="StatusTextBlock"
          Margin="0,6,0,0"
          Opacity="0.78"
          Text="等待输入。"
        />
      </StackPanel>
    </ui:Card>

    <ui:Card Grid.Row="2" Padding="16">
      <ListBox
        x:Name="MessagesListBox"
        BorderThickness="0"
      />
    </ui:Card>

    <ui:Card Grid.Row="4" Padding="16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox
          x:Name="MessageTextBox"
          MinHeight="96"
          Padding="14"
          VerticalContentAlignment="Top"
          AcceptsReturn="True"
          TextWrapping="Wrap"
        />

        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
          <Button
            MinWidth="132"
            Margin="0,0,0,10"
            Click="SendButton_OnClick"
            Content="发送"
          />
          <Button
            MinWidth="132"
            Margin="0,0,0,10"
            Click="InsertTemplateButton_OnClick"
            Content="插入模板"
          />
          <Button
            MinWidth="132"
            Click="ClearConversationButton_OnClick"
            Content="清空会话"
          />
        </StackPanel>
      </Grid>
    </ui:Card>
  </Grid>
</UserControl>
